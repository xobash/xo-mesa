{
  "name": "xo-mesa",
  "version": "0.1.0",
  "description": "A local desktop workspace for research, documents, tools, and action.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/third-party-notices.mjs --check && node scripts/docker-context.check.mjs && vite build && node scripts/bundle-boundaries.check.mjs",
    "test:notices": "node --test scripts/third-party-notices.check.mjs",
    "notices:generate": "node scripts/third-party-notices.mjs --generate",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run",
    "test:release": "node --test scripts/release-gate.check.mjs scripts/public-release-audit.check.mjs",
    "test:bootstrap": "node --test scripts/install-behavior.check.mjs scripts/dev-behavior.check.mjs scripts/launch-cache.check.mjs",
    "test:perf": "vitest run src/lib/graph.perf.test.ts --mode graph-bench",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mesa": "node scripts/dev.mjs",
    "mesa:build": "node scripts/dev.mjs build",
    "mesa:build:windows:offline": "node scripts/dev.mjs build --config src-tauri/tauri.windows.offline.conf.json",
    "tauri": "tauri",
    "test:markdown": "node --test scripts/markdown-behavior.check.mjs",
    "test:index": "node --test scripts/index-search-behavior.check.mjs",
    "test:docker-context": "node scripts/docker-context.check.mjs",
    "bench:index": "node scripts/index-memory-bench.mjs",
    "acceptance:native-template": "node scripts/native-acceptance-template.mjs",
    "acceptance:native-check": "node scripts/native-acceptance-check.mjs",
    "audit:public": "node scripts/public-release-audit.mjs",
    "test:documents": "node scripts/document-fuzz.mjs",
    "test:toolchains": "node --test scripts/toolchain-contract.check.mjs",
    "audit:independent": "node scripts/independent-privacy.mjs",
    "test:assets": "node --test scripts/asset-metadata.check.mjs",
    "audit:assets": "node scripts/asset-metadata.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.4.1",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.2",
    "markdown-it": "^14.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "engines": {
    "node": "22.22.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.25.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}

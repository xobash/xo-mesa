{
  "name": "xo-mesa",
  "version": "0.1.0",
  "description": "A local desktop workspace for research, documents, tools, and action.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/third-party-notices.mjs --check && node scripts/docker-context.check.mjs && vite build && node scripts/bundle-boundaries.check.mjs",
    "notices:generate": "node scripts/third-party-notices.mjs --generate",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mesa": "node scripts/dev.mjs",
    "mesa:build": "node scripts/dev.mjs build",
    "mesa:build:windows:offline": "node scripts/dev.mjs build --config src-tauri/tauri.windows.offline.conf.json",
    "tauri": "tauri",
    "audit:public": "node scripts/public-release-audit.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.4.1",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.2",
    "markdown-it": "^14.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "research-viewer",
  "description": "Detached Deep Research viewer: state relay, docking, close and read-only Pi terminal snapshots.",
  "windows": [
    "research-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "allow-terminal-snapshot"
  ]
}

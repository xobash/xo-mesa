{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main window and spawned document windows.",
  "windows": [
    "main",
    "doc-*",
    "panel-*",
    "agent-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": []
    },
    "allow-sync-status",
    "allow-sync-local-addr",
    "allow-sync-identity",
    "allow-sync-fetch-manifest",
    "allow-sync-cancel",
    "allow-activity-start",
    "allow-activity-set-context",
    "allow-deep-research-respond",
    "allow-activity-stop",
    "allow-browse-fetch",
    "allow-diagnostics-process-tree",
    "allow-vault-scan",
    "allow-vault-read-text",
    "allow-vault-text-fingerprints",
    "allow-vault-rename-no-replace",
    "allow-vault-authorize",
    "allow-vault-authorize-artifacts",
    "allow-vault-flush-file",
    "allow-vault-write-atomic",
    "allow-vault-watch",
    "allow-vault-unwatch"
  ]
}

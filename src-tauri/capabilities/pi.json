{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pi",
  "description": "Terminal commands for the main and detached Pi windows.",
  "windows": [
    "main",
    "agent-*"
  ],
  "permissions": [
    "allow-terminal-start",
    "allow-terminal-attach",
    "allow-terminal-snapshot",
    "allow-terminal-resize",
    "allow-terminal-write",
    "allow-terminal-stop",
    "allow-browse-fetch",
    "allow-terminal-subscribe",
    "allow-terminal-unsubscribe"
  ]
}
